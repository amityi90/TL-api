# --- Local development (plain TCP to a local Postgres) ---
# Setting DB_HOST switches db/index.js into local mode. The Cloud SQL instance
# tl-db has no public IP and cannot be reached from a laptop.
DB_HOST=localhost
DB_PORT=5432
DB_USER=tl_user
DB_PASS=
DB_NAME=tehilalevi

# --- Cloud Run (leave DB_HOST unset to use the Cloud SQL connector) ---
# DB_INSTANCE_CONN=plants-data-api-543316:europe-west3:tl-db
# DB_IP_TYPE=PRIVATE

# Required. The server refuses to start without it.
JWT_SECRET=

# --- Payments ---
# Which provider in services/payments/ handles checkout. Only 'manual' exists
# today: orders are placed as Payment Pending and the admin marks them paid.
# PAYMENT_PROVIDER=manual

# --- Email (Resend, https://resend.com) ---
# Contact-form messages and new-order notifications go to ADMIN_NOTIFY_EMAIL.
# Without RESEND_API_KEY, emails are skipped with a log line (nothing fails).
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
MAIL_FROM=Tehila Levi <notifications@tehilalevi.com>
# ADMIN_NOTIFY_EMAIL=admin@tehilalevi.com
# Optional: adds an "Open in the admin dashboard" link to order emails.
# ADMIN_URL=https://main.d205k7v5rgbdfp.amplifyapp.com

# Product image uploads. On Cloud Run, credentials come from the tl-api-run
# service account via Application Default Credentials — nothing to set here.
# Locally you need: gcloud auth application-default login
GCS_BUCKET=tl-shop-images
# Defaults to https://storage.googleapis.com/<GCS_BUCKET> if unset.
# GCS_PUBLIC_BASE_URL=

# --- Shipping rates at checkout ---
# Off (or unset): every order ships free, as before.
# SHIPPING_ENABLED=true
#
# The rates client always speaks Easyship's API at EASYSHIP_BASE_URL. Today that
# is the built-in static engine (services/shipping/mock, prices in rateTable.js);
# going live is only these values changing:
#                          mock (now)                           real (later)
#   SHIPPING_MOCK_ENABLED  true                                 false
#   EASYSHIP_BASE_URL      http://localhost:5000/mock/easyship  https://public-api.easyship.com
#                          (Cloud Run: https://<service>.run.app/mock/easyship)
#   EASYSHIP_API_TOKEN     same as SHIPPING_MOCK_TOKEN          prod_... from Easyship (secret)
# SHIPPING_MOCK_ENABLED=true
# SHIPPING_MOCK_TOKEN=
# EASYSHIP_BASE_URL=http://localhost:5000/mock/easyship
# EASYSHIP_API_TOKEN=
#
# Where parcels ship from.
# SHIP_FROM_NAME=Tehila Levi
# SHIP_FROM_LINE1=
# SHIP_FROM_CITY=Tel Aviv
# SHIP_FROM_POSTAL_CODE=
# SHIP_FROM_COUNTRY=IL
# SHIP_FROM_PHONE=
# SHIP_FROM_EMAIL=
#
# The one box every order ships in (cm / kg).
# PARCEL_LENGTH_CM=15
# PARCEL_WIDTH_CM=12
# PARCEL_HEIGHT_CM=8
# PARCEL_WEIGHT_KG=0.5
# PARCEL_ITEM_CATEGORY=jewelry
#
# How long a quoted price holds at checkout.
# SHIPPING_QUOTE_TTL_MINUTES=30

PORT=5000

# Comma-separated. Defaults to the two Amplify origins plus localhost:5173/5174.
# CORS_ORIGINS=

# Used only by db/migrate.js when seeding.
# ADMIN_EMAIL=admin@tehilalevi.com
# ADMIN_PASSWORD=
