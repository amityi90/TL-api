# --- Local development (plain TCP to a local Postgres) ---
# Setting DB_HOST switches db/index.js into local mode. The Cloud SQL instance
# tl-db has no public IP and cannot be reached from a laptop.
DB_HOST=localhost
DB_PORT=5432
DB_USER=tl_user
DB_PASS=
DB_NAME=tehilalevi

# --- Cloud Run (leave DB_HOST unset to use the Cloud SQL connector) ---
# DB_INSTANCE_CONN=plants-data-api-543316:europe-west3:tl-db
# DB_IP_TYPE=PRIVATE

# Required. The server refuses to start without it.
JWT_SECRET=

STRIPE_SECRET_KEY=

PORT=5000

# Comma-separated. Defaults to the two Amplify origins plus localhost:5173/5174.
# CORS_ORIGINS=

# Used only by db/migrate.js when seeding.
# ADMIN_EMAIL=admin@tehilalevi.com
# ADMIN_PASSWORD=
